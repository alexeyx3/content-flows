# Copy to vendor/blog/config/.env (git-ignored) and fill in. Names only: no real values here.
# Two more local secrets live next to it and are also git-ignored:
#   google-service-account.json  Google service-account key (Docs and Drive review copies)
#   strapi-api-token             CMS API token, a single line
# An optional fourth file, openai-api-key (a single line), is read only when a run uses the
# direct OpenAI endpoint and OPENAI_GUIDES_API_KEY is not set in the environment.

# SERP provider (vendor/blog/scripts/fetch_google_serp.py). The process environment wins.
XMLRIVER_USER=
XMLRIVER_KEY=

# Default Drive folder for review documents (vendor/blog/scripts/md_to_gdoc.py --folder).
GOOGLE_DRIVE_FOLDER_ID=

# Dedicated OpenRouter key of the guides writer (scripts/openrouter_experiment.py,
# scripts/guide_api.py). Exactly one key is accepted; generic keys are never used. The process
# environment variable of the same name wins over this file.
OPENROUTER_GUIDES_API_KEY=

# Read from the process environment only, never from this file:
#   OPENAI_GUIDES_API_KEY   key for the direct OpenAI endpoint (scripts/openai_guide_experiment.py)
#   CODEX_HOME              Codex home for scripts/sync_agents.py --install-user-skill (default ~/.codex)
#   BLOG_BRAND_DIR          folder with the renderer's font and logo assets (default vendor/brand)
#   BLOG_LOGO_PATH          logo for the visual renderer (default <BLOG_BRAND_DIR>/logo.svg)
