# Copy to config/.env (git-ignored) and fill in. Scripts read this file; nothing here is exported
# to the shell automatically.

# SERP capture (scripts/fetch_google_serp.py, scripts/collect_reddit_signals.py).
# XMLRiver is tried first; DataForSEO is the second provider. Configure at least one.
XMLRIVER_USER=
XMLRIVER_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google service account for Sheets, Docs and Drive. The JSON key itself goes to
# config/google-service-account.json (git-ignored). Share the topic sheet and the review
# folder with the service account's e-mail.
GOOGLE_SA_KEYFILE=config/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_GID=
GOOGLE_DRIVE_FOLDER_ID=

# Other key files, each git-ignored:
#   config/strapi-api-token            CMS API token, one line (also accepted as STRAPI_TOKEN by tools/covers)
#   config/openrouter.env              OpenRouter keys for the hybrid writer, see config/openrouter.env.example
#   config/bing-webmaster-api-key.txt  optional, for the refresh baseline
