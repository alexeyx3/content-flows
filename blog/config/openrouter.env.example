# Copy to config/openrouter.env (git-ignored). Needed only for the hybrid writer; without it
# every role runs on the Codex subscription.

# Used by the older script track (scripts/or_client.py).
OPENROUTER_API_KEY=

# The hybrid blog writer (scripts/blog_openrouter.py) accepts the environment variable
# OPENROUTER_BLOG_API_KEY, or exactly one key in this file whose line, or the comment line right
# above it, carries the label "blog". Keys labelled for other flows are never used. Example:
# blog writer
# sk-or-REPLACE_ME
